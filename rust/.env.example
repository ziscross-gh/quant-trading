# Trading Bot Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# TRADING MODE
# ======================
# Options: paper, live
TRADING_MODE=paper

# ======================
# OANDA BROKER
# ======================
# Get these from: https://www.oanda.com/demo-account/
# API Documentation: https://developer.oanda.com

# Practice/Demo Account (Safe for testing)
OANDA_API_TOKEN=your_practice_api_token_here
OANDA_ACCOUNT_ID=001-004-1234567-001

# Live Account (⚠️ REAL MONEY - Use with caution!)
# OANDA_API_TOKEN=your_live_api_token_here
# OANDA_ACCOUNT_ID=your_live_account_id_here

# ======================
# DATABASE
# ======================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://localhost/trading_db

# Or with authentication:
# DATABASE_URL=postgresql://trader:password123@localhost:5432/trading_db

# ======================
# TELEGRAM NOTIFICATIONS
# ======================
# Get bot token from @BotFather on Telegram
# Get chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ======================
# EMAIL NOTIFICATIONS
# ======================
# SMTP Configuration (Gmail example)
# For Gmail: Enable 2FA and generate App Password
# https://myaccount.google.com/apppasswords

SMTP_SERVER=smtp.gmail.com
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com

# Other providers:
# Outlook: smtp-mail.outlook.com
# Yahoo: smtp.mail.yahoo.com

# ======================
# OPTIONAL SETTINGS
# ======================

# Configuration file path (default: config/config.yaml)
# CONFIG_PATH=config/config.yaml

# Log level (TRACE, DEBUG, INFO, WARN, ERROR)
# RUST_LOG=info

# ======================
# NOTES
# ======================
# 1. Never commit .env file to git (it's in .gitignore)
# 2. Start with TRADING_MODE=paper for testing
# 3. Use OANDA demo account first (free, no risk)
# 4. Test notifications before going live
# 5. Keep your tokens secure!
