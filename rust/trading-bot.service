# Systemd service file for Gold/USD Trading Bot
# Install: sudo cp trading-bot.service /etc/systemd/system/
# Enable: sudo systemctl enable trading-bot
# Start: sudo systemctl start trading-bot
# Status: sudo systemctl status trading-bot
# Logs: journalctl -u trading-bot -f

[Unit]
Description=Gold/USD Autonomous Trading Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/quant-trading/rust

# Environment file with API keys
EnvironmentFile=/home/trader/quant-trading/rust/.env

# Binary
ExecStart=/home/trader/quant-trading/rust/target/release/trade

# Restart policy
Restart=always
RestartSec=10s

# Resource limits
LimitNOFILE=65536
MemoryLimit=1G
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/trader/quant-trading/rust/logs
ReadWritePaths=/home/trader/quant-trading/rust/data

# Logging
StandardOutput=append:/home/trader/quant-trading/rust/logs/systemd.log
StandardError=append:/home/trader/quant-trading/rust/logs/systemd-error.log
SyslogIdentifier=trading-bot

# Health check (optional)
# WatchdogSec=60s

[Install]
WantedBy=multi-user.target
